{
  "expo": {
    "name": "Gainly",
    "slug": "gainly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono-gainly.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gainly.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gainly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#F5F5F4",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#121211"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication"
    ],
    "scheme": "gainly",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b179917e-53b5-4999-8278-1cb2bfb26590"
      }
    },
    "owner": "marco.exe",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b179917e-53b5-4999-8278-1cb2bfb26590"
    }
  }
}
